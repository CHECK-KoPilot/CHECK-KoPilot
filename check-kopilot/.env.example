# 이 파일을 .env로 복사한 뒤 값을 채운다. .env는 gitignore 대상이라 커밋되지 않는다.
#
#   cp .env.example .env
#
# backend/build.gradle이 기동 시 이 파일을 읽어 bootRun 환경변수로 주입한다.
# 이미 셸에 export된 환경변수가 있으면 그쪽이 우선한다.

# OpenAI (ChatGPT) API 키 — 채팅 tool 루프에 사용
OPENAI_API_KEY=

# CHECK API 인증 정보 — 미설정 시 fixture 프로파일로만 기동 가능
CHECK_CUST_ID=
CHECK_API_KEY=

# Admin 수요조사 API 보호용 공유 시크릿 (미설정 시 kopilot-demo)
ADMIN_TOKEN=
